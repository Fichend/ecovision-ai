.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.tsbuildinfo
.pytest_cache/
.mypy_cache/
.next/
node_modules/
frontend/.env.local

# Downloaded datasets and generated model artifacts stay outside Git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/dataset_summary.json
!data/processed/manifest.csv
artifacts/*
!artifacts/.gitkeep
!artifacts/mobilenet_v2_grouped_baseline/
!artifacts/mobilenet_v2_grouped_baseline/**
!artifacts/mobilenet_v2_random_split_baseline/
!artifacts/mobilenet_v2_random_split_baseline/**
data/external/*
!data/external/.gitkeep
